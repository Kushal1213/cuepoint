{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cuepoint",
  "version": "0.3.0",
  "identifier": "io.github.kushal1213.cuepoint",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Cuepoint",
        "label": "splash",
        "url": "splash.html",
        "width": 300,
        "height": 180,
        "resizable": false,
        "visible": true,
        "center": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "decorations": false
      },
      {
        "title": "Cuepoint Overlay",
        "label": "main",
        "width": 800,
        "height": 600,
        "transparent": true,
        "decorations": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      },
      {
        "title": "Cuepoint Settings",
        "label": "settings",
        "url": "settings.html",
        "width": 420,
        "height": 640,
        "resizable": false,
        "visible": false,
        "center": true,
        "skipTaskbar": false,
        "transparent": true,
        "decorations": false
      },
      {
        "title": "Cuepoint Task History",
        "label": "history",
        "url": "history.html",
        "width": 460,
        "height": 620,
        "resizable": false,
        "visible": false,
        "center": true,
        "skipTaskbar": false,
        "transparent": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Kushal Choudhary",
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/browser/browser-driver.js",
      "resources/browser/package.json"
    ]
  }
}
